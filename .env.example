# ============================================================
# WoroWoroInv - environment variable
# Lokal : salin file ini menjadi `.env.local`
# Vercel: Project > Settings > Environment Variables
#         (tempel seluruh isi sekaligus, Vercel memecahnya per baris)
#
# TIPS: buka halaman /admin saat ADMIN_PASSWORD belum diisi,
# di sana ada generator isi file ini + panduan langkah demi langkah.
# ============================================================

# --- WAJIB (3 variabel) ---
# Midtrans Dashboard > Settings > Access Keys
# Mode otomatis: key berawalan "SB-" = Sandbox (uji coba), selain itu = Production
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
# Password untuk login admin di /admin (minimal 8 karakter, buat yang sulit ditebak)
ADMIN_PASSWORD=ganti-dengan-password-kuat

# --- OPSIONAL ---
# Nomor WhatsApp admin (format 628xxxxxxxxxx), untuk tombol "Kirim detail ke admin"
ADMIN_WHATSAPP=6281234567890
# URL website; bila kosong dideteksi otomatis
SITE_URL=
# Paksa mode (jarang perlu): sandbox | production
MIDTRANS_ENV=

# --- LINK UNDANGAN OTOMATIS (opsional, gratis) ---
# Cara termudah: Vercel > Storage > Upstash Redis (Free) > Connect Project; dua variabel di bawah terisi sendiri.
# Atau isi manual dari upstash.com (REST URL & REST Token):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (integrasi Vercel memakai nama KV_REST_API_URL / KV_REST_API_TOKEN; keduanya didukung)
